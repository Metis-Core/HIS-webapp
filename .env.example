# Copy to .env.local for local development. Never commit real values.

# Base URL the browser uses for API calls. Leave as /his to go through the Next.js
# rewrite below (same-origin, no CORS needed), or set the API's public HTTPS URL.
NEXT_PUBLIC_API_URL=/his

# Server-side target of the /his/* rewrite (next.config.ts). Use the API's HTTPS URL in
# production; its origin must also be listed in the API's CORS_ORIGINS if the browser
# calls it directly.
API_UPSTREAM=http://localhost:8000
